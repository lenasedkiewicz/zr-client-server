# Python bytecode / cache
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# IDE / editor
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db

# User accounts (password hashes - never commit)
users.json

# TLS certificate and private key (generated locally - never commit the real key)
/server.crt
/server.key
*.pem
